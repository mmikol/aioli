# Copy to .env and fill in. .env is never committed.

# The recipe source. Sign up at https://spoonacular.com/food-api/console
# The free tier is 50 points a day and will not plan a week; Cook is $29/mo
# for 1,500. Without a key the board runs and the planner cannot search.
SPOONACULAR_KEY=
SPOONACULAR_TIER=free

# The database the compose stack brings up. Change this before any machine
# but your own sees it: the port is published on 127.0.0.1 and a default
# password is a default password.
POSTGRES_PASSWORD=aioli

# The clock's timezone, so a cook session lands on the right evening.
TZ=America/Los_Angeles

# --- how much of the host this stack may take --------------------------------
#
# The defaults below suit the machine this is written on: an 18-core M5 Pro
# with 64 GB, where the stack is a rounding error and PostgreSQL may as well
# be comfortable. Nothing here is a reservation - a container that does not
# need the memory does not hold it, and PostgreSQL idles around 16 MB whatever
# the ceiling says.
AIOLI_APP_MEMORY=1g
AIOLI_APP_PIDS=256
AIOLI_DB_MEMORY=2g
AIOLI_DB_PIDS=128
AIOLI_DB_SHARED_BUFFERS=512MB
AIOLI_DB_MAX_CONNECTIONS=40

# On a 16 GB host that is also running a local model, use these instead. The
# stack still works; it simply stops assuming headroom it does not have.
#
#   AIOLI_APP_MEMORY=512m
#   AIOLI_DB_MEMORY=768m
#   AIOLI_DB_SHARED_BUFFERS=128MB
#   AIOLI_DB_MAX_CONNECTIONS=20
